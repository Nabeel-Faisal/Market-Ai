<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	# HTML must revalidate every time. It names the hashed asset files, so a
	# cached copy pins visitors to a previous build — the old default here put
	# index.html in the CDN for a week, which outlives most deploys.
	Header set Cache-Control "public, max-age=0, s-maxage=0, must-revalidate"

	# Asset filenames carry a content hash, so a changed file is a new URL and
	# the old one can be kept indefinitely.
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>

	# Fonts are hashed by filename too and change even less often.
	<If "%{REQUEST_URI} =~ m#^/fonts/.*$#">
		Header set Cache-Control "public, max-age=31536000"
	</If>
</IfModule>
